def parse_points(raw):
    points = []
    for chunk in raw.strip().split(";"):
        chunk = chunk.strip()
        if not chunk:
            continue
        x_str, y_str = chunk.split(",")
        points.append((int(round(float(x_str.strip()))), int(round(float(y_str.strip())))))
    if not points:
        raise ValueError("No click points parsed — expected format 'x1,y1;x2,y2'")
    return points


def load_image(source):
    if source.startswith("http://") or source.startswith("https://"):
        print(f"[*] Downloading image from URL: {source}")
        req = urllib.request.Request(source, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req) as resp:
            data = resp.read()
        image = Image.open(io.BytesIO(data)).convert("RGB")
    else:
        print(f"[*] Loading image from local path: {source}")
        image = Image.open(source).convert("RGB")
    return image


def resize_image_and_points(image, click_points, max_dim=1024, multiple_of=16):
    orig_w, orig_h = image.size
    scale = max_dim / max(orig_w, orig_h)

    new_w = int(round(orig_w * scale))
    new_h = int(round(orig_h * scale))
    new_w = max(multiple_of, (new_w // multiple_of) * multiple_of)
    new_h = max(multiple_of, (new_h // multiple_of) * multiple_of)
    resized = image.resize((new_w, new_h), Image.LANCZOS)
    scale_x = new_w / orig_w
    scale_y = new_h / orig_h
    rescaled_points = [
        (int(round(x * scale_x)), int(round(y * scale_y))) for (x, y) in click_points
    ]
    return resized, rescaled_points, scale_x, scale_y


def run_inputs():
    parser = argparse.ArgumentParser()
    parser.add_argument("--image")
    parser.add_argument("--prompt")
    parser.add_argument("--points")
    parser.add_argument("--choices", default=None,
                         help="Optional comma-separated candidate indices (0/1/2) per click, "
                              "e.g. '2,0' to skip interactive prompts")
    parser.add_argument("--steps", type=int, default=14)
    parser.add_argument("--warmup-steps", type=int, default=2)
    parser.add_argument("--guidance", type=float, default=GUIDANCE)
    parser.add_argument("--dilate-px", type=int, default=6)
    parser.add_argument("--max-dim", type=int, default=512)
    parser.add_argument("--skip-depth", action="store_true",
                         help="Skip depth map generation for parallax/3D preview")
    parser.add_argument("--mode", choices=["fill", "drag"], default="fill",
                         help="'fill' = creative inpaint with --prompt (default). "
                              "'drag' = extract clicked object as a draggable cutout "
                              "and fill the hole it leaves, for a drag-and-drop UI.")
    args, _ = parser.parse_known_args()

    image_source = args.image
    while not image_source:
        image_source = input("Image path or URL: ").strip()

    mode = args.mode
    prompt = args.prompt
    if mode == "fill":
        while not prompt:
            prompt = input("Edit prompt: ").strip()
    else:
        prompt = prompt or ""

    points_raw = args.points
    while not points_raw:
        points_raw = input("Click points, format 'x1,y1;x2,y2': ").strip()
    click_points = parse_points(points_raw)

    preselected_choices = None
    if args.choices:
        preselected_choices = [int(c.strip()) for c in args.choices.split(",")]

    return {
        "image_source": image_source,
        "prompt": prompt,
        "click_points": click_points,
        "preselected_choices": preselected_choices,
        "steps": args.steps,
        "warmup_steps": args.warmup_steps,
        "guidance": args.guidance,
        "dilate_px": args.dilate_px,
        "max_dim": args.max_dim,
        "skip_depth": args.skip_depth,
        "mode": args.mode,
    }


def load_sam2_predictor(cfg_name, ckpt_path):
    if GlobalHydra.instance().is_initialized():
        GlobalHydra.instance().clear()
    with initialize_config_dir(config_dir=SAM2_CONFIG_DIR, version_base="1.2"):
        cfg = compose(config_name=cfg_name)
        model = instantiate(cfg.model, _recursive_=True)
        _load_checkpoint(model, ckpt_path)
        model = model.to("cuda").eval()
    return SAM2ImagePredictor(model), model


def clean_mask(mask01, close_iterations=8):
    mask = mask01.astype(bool)
    mask = binary_closing(mask, iterations=close_iterations)
    mask = binary_fill_holes(mask)

    labeled, n = cc_label(mask)
    if n > 1:
        sizes = np.bincount(labeled.ravel())
        sizes[0] = 0
        mask = labeled == sizes.argmax()

    return mask.astype(np.uint8)


def generate_mask_candidates(sam2_predictor, point, prev_logits=None):
    coords = np.array([list(point)], dtype=np.float32)
    labels = np.array([1], dtype=np.int32)
    masks, scores, logits = sam2_predictor.predict(
        point_coords=coords,
        point_labels=labels,
        mask_input=prev_logits[None, ...] if prev_logits is not None else None,
        multimask_output=True,
    )
    candidates = [clean_mask(m) for m in masks]
    return candidates, scores, logits


def save_candidate_previews(image, candidates, scores, point, click_index, out_dir="."):
    paths = []
    for idx, (mask01, score) in enumerate(zip(candidates, scores)):
        base = image.convert("RGBA")
        overlay_layer = Image.new("RGBA", base.size, (173, 216, 230, 0))
        alpha_mask = Image.fromarray((mask01 * 110).astype(np.uint8))
        overlay_layer.putalpha(alpha_mask)
        overlay = Image.alpha_composite(base, overlay_layer).convert("RGB")

        draw = ImageDraw.Draw(overlay)
        x, y = point
        r = 5
        draw.ellipse([x - r, y - r, x + r, y + r], fill=(255, 0, 0), outline=(255, 0, 0))

        path = f"{out_dir}/click{click_index}_candidate{idx}_score{score:.2f}.png"
        overlay.save(path)
        paths.append(path)
        print(f" click {click_index} candidate #{idx}: sam2_score={score:.3f}, "
              f"-> saved {path}")
    return paths


def choose_candidate(candidates, click_index, paths, preselected=None):
    if preselected is not None:
        print(f" click {click_index}: using preselected candidate #{preselected}")
        return candidates[preselected]

    print(f"\n click {click_index}: open these preview images and pick an index —")
    for idx, path in enumerate(paths):
        print(f"    {idx}: {path}")

    while True:
        choice = input(f" click {click_index}: enter choice (0-{len(candidates)-1}): ").strip()
        if choice.isdigit() and int(choice) < len(candidates):
            return candidates[int(choice)]
        print(" Invalid choice, try again.")


def segment_clicked_objects(sam2_predictor, click_points, image, preselected_choices=None):
    if len(click_points) == 2 and all(isinstance(v, (int, float)) for v in click_points):
        click_points = [click_points]

    combined = None
    for i, point in enumerate(click_points):
        candidates, scores, _ = generate_mask_candidates(sam2_predictor, point)
        paths = save_candidate_previews(image, candidates, scores, point, i)

        pick = None
        if preselected_choices is not None and i < len(preselected_choices):
            pick = preselected_choices[i]
        chosen_mask = choose_candidate(candidates, i, paths, preselected=pick)

        print(f" click {i} at {point}: FINAL chosen mask = "
              f"{chosen_mask.sum()} px ({100*chosen_mask.sum()/chosen_mask.size:.1f}%)")
        combined = chosen_mask if combined is None else np.logical_or(combined, chosen_mask).astype(np.uint8)
    return combined


def save_masks(image, mask01, click_points, mask_path="sam2_mask.png",
               overlay_path="overlay.png", marker_radius=5):
    if len(click_points) == 2 and all(isinstance(v, (int, float)) for v in click_points):
        click_points = [click_points]

    mask_img = Image.fromarray((mask01 * 255).astype(np.uint8)).convert("RGB")
    mask_img.save(mask_path)
    base = image.convert("RGBA")

    overlay_layer = Image.new("RGBA", base.size, (173, 216, 230, 0))
    alpha_mask = Image.fromarray((mask01 * 110).astype(np.uint8))
    overlay_layer.putalpha(alpha_mask)
    overlay = Image.alpha_composite(base, overlay_layer).convert("RGB")
    draw = ImageDraw.Draw(overlay)
    r = marker_radius
    for (x, y) in click_points:
        draw.ellipse([x - r, y - r, x + r, y + r], fill=(255, 0, 0), outline=(255, 0, 0))
    overlay.save(overlay_path)
    print(f" saved mask -> {mask_path}")
    print(f" saved overlay -> {overlay_path}")


