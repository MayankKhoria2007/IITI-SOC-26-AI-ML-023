def save_dragdrop_assets(clean_bg, cutout, bbox, centroid,
                          bg_path="background_clean.png",
                          cutout_path="object_cutout.png",
                          meta_path="object_meta.json"):
    import json

    clean_bg.save(bg_path)
    cutout.save(cutout_path)

    meta = {
        "bbox": {"x0": bbox[0], "y0": bbox[1], "x1": bbox[2], "y1": bbox[3]},
        "centroid": {"x": centroid[0], "y": centroid[1]},
        "cutout_size": {"width": cutout.width, "height": cutout.height},
        "background_size": {"width": clean_bg.width, "height": clean_bg.height},
    }
    with open(meta_path, "w") as f:
        json.dump(meta, f, indent=2)

    print(f" saved clean background -> {bg_path}")
    print(f" saved object cutout    -> {cutout_path}")
    print(f" saved placement meta   -> {meta_path}")
    return meta


def load_depth_model(model_name=DEPTH_MODEL):
    t0 = time.perf_counter()
    processor = AutoImageProcessor.from_pretrained(model_name)
    model = AutoModelForDepthEstimation.from_pretrained(
        model_name, torch_dtype=torch.float16
    ).to("cuda").eval()
    print(f"[*] Depth model loaded in {time.perf_counter()-t0:.2f}s")
    return processor, model


def run_depth_estimation(processor, model, image,
                          depth_path_8bit="depth_preview.png",
                          depth_path_16bit="depth_raw16.png"):
    torch.cuda.synchronize()
    t0 = time.perf_counter()

    inputs = processor(images=image, return_tensors="pt").to("cuda", torch.float16)
    with torch.inference_mode():
        outputs = model(**inputs)
        predicted_depth = outputs.predicted_depth

    prediction = torch.nn.functional.interpolate(
        predicted_depth.unsqueeze(1).float(),
        size=(image.height, image.width),
        mode="bicubic",
        align_corners=False,
    ).squeeze()

    torch.cuda.synchronize()
    latency = time.perf_counter() - t0

    depth_np = prediction.cpu().numpy().astype(np.float32)
    d_min, d_max = depth_np.min(), depth_np.max()
    depth_norm = (depth_np - d_min) / max(d_max - d_min, 1e-6)

    depth_8bit = (depth_norm * 255.0).astype(np.uint8)
    depth_16bit = (depth_norm * 65535.0).astype(np.uint16)

    depth_vis = Image.fromarray(depth_8bit, mode="L")
    depth_vis.save(depth_path_8bit)
    Image.fromarray(depth_16bit, mode="I;16").save(depth_path_16bit)

    peak_vram = torch.cuda.max_memory_allocated() / (1024 ** 3)
    print("\n" + "=" * 50)
    print("             DEPTH ESTIMATION METRICS")
    print("=" * 50)
    print(f" Model: {DEPTH_MODEL}")
    print(f" Input size: {image.size}")
    print(f" Inference time: {latency*1000:.1f} ms")
    print(f" Peak VRAM Utilized: {peak_vram:.2f} GB")
    print(f" saved 8-bit preview -> {depth_path_8bit}")
    print(f" saved 16-bit raw    -> {depth_path_16bit}")
    print("=" * 50)

    return depth_vis, depth_np


def unload_depth_model(processor, model):
    del processor, model
    gc.collect()
    torch.cuda.empty_cache()
    torch.cuda.synchronize()
    print(f" GPU mem after depth-model unload: "
          f"{torch.cuda.memory_allocated() / (1024**3):.2f} GB allocated, "
          f"{torch.cuda.memory_reserved() / (1024**3):.2f} GB reserved")


if __name__ == "__main__":
    cfg = run_inputs()

    init_image = load_image(cfg["image_source"])
    init_image, click_points, _, _ = resize_image_and_points(
        init_image, cfg["click_points"], max_dim=1024, multiple_of=16,
    )
    print(f" init_image size (resized): {init_image.size}")
    reference_image = load_image("https://res.cloudinary.com/econjyh1/image/upload/f_auto,q_auto/bed1_wwt6ms")
    sam2_predictor, sam2_model = load_sam2_predictor(SAM2_CFG, SAM2_CKPT)
    sam2_predictor.set_image(np.array(init_image))

    full_mask = segment_clicked_objects(
        sam2_predictor, click_points, init_image,
        preselected_choices=cfg["preselected_choices"],
    )

    unload_sam2(sam2_predictor, sam2_model)

    save_masks(init_image, full_mask, click_points)

    if cfg["mode"] == "drag":
        cutout, bbox, centroid = extract_object_cutout(init_image, full_mask, feather_px=3)

        lama = load_lama_model()
        clean_bg = remove_object_from_scene(lama, init_image, full_mask, dilate_px=cfg["dilate_px"])
        unload_lama_model(lama)

        meta = save_dragdrop_assets(clean_bg, cutout, bbox, centroid)

        if not cfg["skip_depth"]:
            depth_processor, depth_model = load_depth_model()
            depth_vis, depth_raw = run_depth_estimation(depth_processor, depth_model, init_image)
            unload_depth_model(depth_processor, depth_model)
            print("[SUCCESS] Depth maps saved for placement scaling: "
                  "depth_preview.png (8-bit) + depth_raw16.png (16-bit)")

        print("\n[SUCCESS] Drag-and-drop assets ready:")
        print("  background_clean.png  — scene with object removed")
        print("  object_cutout.png     — the draggable object (RGBA, feathered edge)")
        print("  object_meta.json      — bbox/centroid for placement + depth scaling")
        print("  depth_preview.png     — for depth-aware auto-scale in the frontend")

    else:
        pipe = load_flux_pipeline(FLUX_MODEL)
        prompt_embeds, pooled_prompt_embeds = encode_prompt_and_free_encoders(pipe, cfg["prompt"], reference_image)

        final_output = run_flux_fill_with_metrics(
            pipe, init_image, full_mask,
            prompt_embeds, pooled_prompt_embeds,
            steps=cfg["steps"],
            warmup_steps=cfg["warmup_steps"],
            guidance=cfg["guidance"],
            dilate_px=cfg["dilate_px"],
            seed=SEED,
        )

        unload_flux(pipe)

        output_filename = "flux_fill_final.png"
        final_output.save(output_filename)
        print(f"\n[SUCCESS] Image successfully processed and saved to: {output_filename}")

        if not cfg["skip_depth"]:
            depth_processor, depth_model = load_depth_model()
            depth_vis, depth_raw = run_depth_estimation(depth_processor, depth_model, final_output)
            unload_depth_model(depth_processor, depth_model)
            print("[SUCCESS] Depth maps saved: depth_preview.png (8-bit) + depth_raw16.png (16-bit)")
            print("          Hand color (flux_fill_final.png) + depth_raw16.png to the WebGL parallax shader.")
        else:
            print("[*] --skip-depth set, no depth map generated.")
