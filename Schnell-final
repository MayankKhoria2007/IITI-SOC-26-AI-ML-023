import time
from pathlib import Path

import modal

APP_NAME = "flux-schnell-lora"
MODEL_ID = "black-forest-labs/FLUX.1-schnell"
LORA_FILENAME = "adapter_model.safetensors"
LORA_VOLUME_PATH = "/loras"
HF_CACHE_VOLUME_PATH = "/cache"

PROMPT = "A beautifully designed living room interior with a plush velvet sofa, ornate wooden coffee table, tall bookshelf, cozy armchair by the window, patterned area rug, elegant floor lamps, framed wall art, potted plants, marble fireplace, sheer curtains with warm golden hour sunlight, hardwood flooring, mix of modern and vintage furniture, photorealistic, ultra detailed, 8k, interior design magazine photography"

FIXED_STEPS = 4

image = (
    modal.Image.debian_slim(python_version="3.11")
    .apt_install("git")
    .pip_install(
        "torch==2.5.1",
        "torchvision",
        index_url="https://download.pytorch.org/whl/cu124",
    )
    .pip_install(
        "diffusers",
        "transformers",
        "accelerate",
        "bitsandbytes",
        "safetensors",
        "sentencepiece",
        "huggingface_hub",
        "pillow",
        "peft",
        "cloudinary",
        "fastapi[standard]",
        "pydantic",
    )
)

app = modal.App(APP_NAME)

hf_cache_volume = modal.Volume.from_name("flux-hf-cache", create_if_missing=True)
lora_volume = modal.Volume.from_name("flux-lora-volume", create_if_missing=True)


@app.cls(
    gpu="L4",
    image=image,
    volumes={
        HF_CACHE_VOLUME_PATH: hf_cache_volume,
        LORA_VOLUME_PATH: lora_volume,
    },
    secrets=[
        modal.Secret.from_name("huggingface-secret-2"),
        modal.Secret.from_name("CLOUDINARY_API_KEY"),
        modal.Secret.from_name("CLOUDINARY_CLOUD_NAME"),
        modal.Secret.from_name("CLOUDINARY_API_SECRET"),
    ],
    timeout=900,
    scaledown_window=600,
)
class FluxLoRA:

    @modal.enter()
    def load_models(self):
        cold_start_begin = time.perf_counter()
        print("[COLD START] Fresh container initializing...")

        import os
        os.environ["PYTORCH_CUDA_ALLOC_CONF"] = "expandable_segments:True"
        os.environ["HF_HOME"] = f"{HF_CACHE_VOLUME_PATH}/huggingface"
        os.environ["TORCHINDUCTOR_CACHE_DIR"] = f"{HF_CACHE_VOLUME_PATH}/inductor_cache"
        os.environ["TORCHINDUCTOR_FX_GRAPH_CACHE"] = "1"

        import warnings
        warnings.filterwarnings("ignore", category=FutureWarning)

        import torch
        from diffusers import (
            FluxPipeline,
            FluxTransformer2DModel,
            BitsAndBytesConfig as DiffusersBnbConfig,
        )
        from transformers import (
            T5EncoderModel,
            BitsAndBytesConfig as TransformersBnbConfig,
        )
        from safetensors.torch import load_file
        import cloudinary

        hf_cache_volume.reload()
        lora_volume.reload()

        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cudnn.allow_tf32 = True
        torch.backends.cuda.enable_flash_sdp(False)
        torch.backends.cuda.enable_mem_efficient_sdp(True)

        self.torch = torch
        self.dtype = torch.float16

        cloudinary.config(
            cloud_name=os.environ.get("CLOUDINARY_CLOUD_NAME"),
            api_key=os.environ.get("CLOUDINARY_API_KEY"),
            api_secret=os.environ.get("CLOUDINARY_API_SECRET"),
            secure=True,
        )

        hf_token = os.environ.get("HF_TOKEN") or os.environ.get("HUGGINGFACE_TOKEN")
        if not hf_token:
            raise EnvironmentError(
                "HF_TOKEN not found in environment — create a Modal secret with "
                "`modal secret create huggingface-secret-2 HF_TOKEN=hf_...` and make "
                "sure it's attached to this app."
            )

        # ── LoRA adapter must already be present in the volume ─────────────
        lora_path = f"{LORA_VOLUME_PATH}/{LORA_FILENAME}"
        if not os.path.exists(lora_path):
            raise FileNotFoundError(
                f"LoRA adapter not found at {lora_path!r} even after volume "
                f"reload. Upload it first with:\n"
                f"  modal volume put flux-lora-volume ./{LORA_FILENAME} /{LORA_FILENAME}\n"
                f"The app will not download it automatically."
            )
        print(f"[CACHE] LoRA found in volume: {lora_path}")

        hf_hub_cache_dir = Path(os.environ["HF_HOME"]) / "hub"
        model_cache_dirname = "models--" + MODEL_ID.replace("/", "--")
        model_cache_hit = (hf_hub_cache_dir / model_cache_dirname).exists()
        print(
            f"[CACHE] HF model cache {'HIT' if model_cache_hit else 'MISS'} "
            f"for {MODEL_ID} at {hf_hub_cache_dir / model_cache_dirname}"
        )

        load_start = time.perf_counter()

        bnb_transformer = DiffusersBnbConfig(
            load_in_4bit=True,
            bnb_4bit_quant_type="nf4",
            bnb_4bit_compute_dtype=self.dtype,
            bnb_4bit_use_double_quant=True,
        )
        bnb_text = TransformersBnbConfig(
            load_in_4bit=True,
            bnb_4bit_quant_type="nf4",
            bnb_4bit_compute_dtype=self.dtype,
            bnb_4bit_use_double_quant=True,
        )

        transformer = FluxTransformer2DModel.from_pretrained(
            MODEL_ID,
            subfolder="transformer",
            quantization_config=bnb_transformer,
            torch_dtype=self.dtype,
            token=hf_token,
        )

        text_encoder_2 = T5EncoderModel.from_pretrained(
            MODEL_ID,
            subfolder="text_encoder_2",
            quantization_config=bnb_text,
            torch_dtype=self.dtype,
            token=hf_token,
        )

        self.pipe = FluxPipeline.from_pretrained(
            MODEL_ID,
            transformer=transformer,
            text_encoder_2=text_encoder_2,
            torch_dtype=self.dtype,
            token=hf_token,
        )

        self.pipe.to("cuda")
        self.pipe.vae.enable_slicing()
        self.pipe.vae.enable_tiling()
        self.pipe.set_progress_bar_config(disable=True)

        hf_cache_volume.commit()
        print(f"[CACHE] HF cache committed to volume ({'was a hit' if model_cache_hit else 'freshly downloaded'})")

        lora_state_dict = load_file(lora_path)
        cleaned_state_dict = {
            k.replace("base_model.model.", ""): v
            for k, v in lora_state_dict.items()
        }
        self.pipe.transformer.load_lora_adapter(
            cleaned_state_dict,
            adapter_name="default",
            prefix=None,
        )

        load_time = time.perf_counter() - load_start
        print(f"\nModel Load Time: {load_time:.2f}s")

        self.pipe.transformer = torch.compile(
            self.pipe.transformer,
            mode="reduce-overhead",
        )
        with torch.inference_mode():
            prompt_embeds, pooled_prompt_embeds, _ = self.pipe.encode_prompt(
                prompt=PROMPT,
                max_sequence_length=512,
            )
            _ = self.pipe(
                prompt_embeds=prompt_embeds,
                pooled_prompt_embeds=pooled_prompt_embeds,
                num_inference_steps=FIXED_STEPS,
                guidance_scale=0.0,
                height=1024,
                width=1024,
            )
        print("Warmup done")

        # Persist the freshly written torch.compile inductor cache (in
        # addition to the HF cache already committed above) so the NEXT
        # cold start can reuse compiled kernels instead of recompiling.
        hf_cache_volume.commit()

        self.is_cold_start = True
        cold_start_total = time.perf_counter() - cold_start_begin
        print(f"[COLD START] Total cold start time (load + compile + warmup): {cold_start_total:.2f}s")

    def _upload_to_cloudinary(self, pil_image, public_id: str) -> str:
        """Upload a PIL image to Cloudinary; return its secure URL."""
        import cloudinary.uploader
        import io as _io
        buf = _io.BytesIO()
        pil_image.save(buf, format="PNG")
        buf.seek(0)
        result = cloudinary.uploader.upload(
            buf,
            public_id=public_id,
            folder="flux-sam2",
            overwrite=True,
            resource_type="image",
            timeout=30,
        )
        return result["secure_url"]

    @modal.method()
    def generate(self, prompt: str, height: int = 1024, width: int = 1024) -> dict:
        # NOTE: steps is intentionally not a parameter — it's fixed to
        # FIXED_STEPS below so nothing upstream can accidentally slow
        # this down by passing a different step count.
        import uuid as _uuid

        if getattr(self, "is_cold_start", False):
            print("[COLD START] This is the first request served by this fresh container.")
            self.is_cold_start = False
        else:
            print("[WARM] Reusing an already-initialized container for this request.")

        with self.torch.inference_mode():
            prompt_embeds, pooled_prompt_embeds, _ = self.pipe.encode_prompt(
                prompt=prompt,
                max_sequence_length=512,
            )

        self.torch.cuda.synchronize()
        self.torch.cuda.reset_peak_memory_stats()
        start = time.perf_counter()
        with self.torch.inference_mode():
            result = self.pipe(
                prompt_embeds=prompt_embeds,
                pooled_prompt_embeds=pooled_prompt_embeds,
                num_inference_steps=FIXED_STEPS,
                guidance_scale=0.0,
                height=height,
                width=width,
                output_type="pil",
            )
        self.torch.cuda.synchronize()
        latency = time.perf_counter() - start
        peak_vram = self.torch.cuda.max_memory_allocated() / (1024 ** 3)
        print(f"\nInference Time : {latency:.2f}s")
        print(f"Peak VRAM      : {peak_vram:.2f} GB")

        image = result.images[0]

        upload_start = time.perf_counter()
        cloudinary_url = self._upload_to_cloudinary(
            image, public_id=f"flux-schnell-lora/output_{_uuid.uuid4().hex}"
        )
        print(f"Cloudinary upload time: {time.perf_counter() - upload_start:.2f}s")
        print(f"Cloudinary URL : {cloudinary_url}")

        return {"cloudinary_url": cloudinary_url}


@app.local_entrypoint()
def main():
    prompt = input("Enter your prompt: ").strip()
    while not prompt:
        prompt = input("Prompt cannot be empty. Enter your prompt: ").strip()

    result = FluxLoRA().generate.remote(prompt)
    print(f"Cloudinary URL: {result['cloudinary_url']}")


from pydantic import BaseModel


class GenerateRequest(BaseModel):
    prompt: str
    height: int = 1024
    width: int = 1024
    # steps intentionally removed from the public API — always FIXED_STEPS


@app.function(image=image, timeout=900)
@modal.asgi_app()
def fastapi_app():
    from fastapi import FastAPI, HTTPException

    web_app = FastAPI(title="FLUX Schnell LoRA", version="1.0.0")

    @web_app.post("/generate")
    def generate_endpoint(payload: GenerateRequest):
        try:
            result = FluxLoRA().generate.remote(
                payload.prompt, payload.height, payload.width
            )
        except Exception as exc:
            raise HTTPException(status_code=500, detail=str(exc))
        return result

    return web_app
