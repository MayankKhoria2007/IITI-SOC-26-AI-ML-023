# ---------------------------------------------------------------------------
# TeaCache constants
# ---------------------------------------------------------------------------
POLY_COEFFS = [
    4.98651651e+02,
   -2.83781631e+02,
    5.58554382e+01,
   -3.82021401e+00,
    2.64230861e-01,
]
REL_L1_THRESH = 0.25
MAX_CONSECUTIVE_SKIPS = 2

DEPTH_MODEL = "depth-anything/Depth-Anything-V2-Small-hf"


@contextmanager
def timed(label: str):
    t0 = time.time()
    try:
        yield
    finally:
        print(f"[TIMER] {label}: {time.time() - t0:.3f}s")


def _poly1d(coeffs, x):
    result = 0.0
    for c in coeffs:
        result = result * x + c
    return result

def pad_to_square(image):
    image = image.convert("RGB")
    w, h = image.size
    side = max(w, h)
    padded = Image.new("RGB", (side, side), (255, 255, 255))
    x = (side - w) // 2
    y = (side - h) // 2
    padded.paste(image, (x, y))
    return padded

def pad_mask_to_square(mask_image):
    mask_image = mask_image.convert("L")
    w, h = mask_image.size
    side = max(w, h)
    padded = Image.new("L", (side, side), 0)
    x = (side - w) // 2
    y = (side - h) // 2
    padded.paste(mask_image, (x, y))
    return padded

def remove_pad(padded_image, original_width, original_height):
    cur_w, cur_h = padded_image.size
    left = (cur_w - original_width) // 2
    top = (cur_h - original_height) // 2
    right = left + original_width
    bottom = top + original_height
    return padded_image.crop((left, top, right, bottom))

def apply_teacache(pipe, num_steps: int, rel_l1_thresh: float = REL_L1_THRESH):
    """Patch the transformer's forward pass with TeaCache step-skipping."""
    transformer = getattr(pipe.transformer, "_orig_mod", pipe.transformer)

    transformer.tc_cnt = 0
    transformer.tc_num_steps = num_steps
    transformer.tc_rel_l1_thresh = rel_l1_thresh
    transformer.tc_accumulated_rel_l1 = 0.0
    transformer.tc_previous_modulated_input = None
    transformer.tc_previous_residual = None
    transformer.tc_skip_count = 0
    transformer.tc_consecutive_skips = 0
    transformer.tc_enabled = True
    transformer.tc_latent_channels = None

    original_forward = transformer.forward

    def teacache_forward(
        hidden_states,
        encoder_hidden_states=None,
        pooled_projections=None,
        timestep=None,
        img_ids=None,
        txt_ids=None,
        guidance=None,
        joint_attention_kwargs=None,
        return_dict=True,
        **kwargs,
    ):
        temb = transformer.time_text_embed(timestep, guidance, pooled_projections)
        inp = transformer.x_embedder(hidden_states)
        temb_ = temb.clone()
        modulated_inp, _, _, _, _ = transformer.transformer_blocks[0].norm1(
            inp, emb=temb_
        )

        cnt = transformer.tc_cnt
        n_steps = transformer.tc_num_steps

        if cnt == 0 or cnt == n_steps - 1:
            should_calc = True
            transformer.tc_accumulated_rel_l1 = 0.0
        else:
            rel_diff = (
                (modulated_inp - transformer.tc_previous_modulated_input).abs().mean()
                / transformer.tc_previous_modulated_input.abs().mean()
            ).cpu().item()
            transformer.tc_accumulated_rel_l1 += float(_poly1d(POLY_COEFFS, rel_diff))
            if (
                transformer.tc_accumulated_rel_l1 < transformer.tc_rel_l1_thresh
                and transformer.tc_consecutive_skips < MAX_CONSECUTIVE_SKIPS
            ):
                should_calc = False
            else:
                should_calc = True
                transformer.tc_accumulated_rel_l1 = 0.0

        transformer.tc_previous_modulated_input = modulated_inp.clone()
        transformer.tc_cnt += 1

        if not should_calc:
            transformer.tc_skip_count += 1
            transformer.tc_consecutive_skips += 1
            lc = transformer.tc_latent_channels
            latent_slice = hidden_states[..., :lc]
            out = latent_slice + transformer.tc_previous_residual
            if return_dict:
                from diffusers.models.modeling_outputs import Transformer2DModelOutput
                return Transformer2DModelOutput(sample=out)
            return (out,)

        transformer.tc_consecutive_skips = 0
        output = original_forward(
            hidden_states=hidden_states,
            encoder_hidden_states=encoder_hidden_states,
            pooled_projections=pooled_projections,
            timestep=timestep,
            img_ids=img_ids,
            txt_ids=txt_ids,
            guidance=guidance,
            joint_attention_kwargs=joint_attention_kwargs,
            return_dict=return_dict,
            **kwargs,
        )

        out_tensor = output.sample if return_dict else output[0]
        transformer.tc_latent_channels = out_tensor.shape[-1]
        input_latent_slice = hidden_states[..., : out_tensor.shape[-1]].detach().clone()
        transformer.tc_previous_residual = out_tensor.detach().clone() - input_latent_slice
        return output

    transformer.forward = teacache_forward
    return original_forward

def remove_teacache(pipe, original_forward):
    """Restore the original transformer forward and log skip stats."""
    transformer = getattr(pipe.transformer, "_orig_mod", pipe.transformer)
    print(
        f" TeaCache skipped {transformer.tc_skip_count}/{transformer.tc_num_steps} steps"
    )
    transformer.forward = original_forward
    transformer.tc_enabled = False
    transformer.tc_cnt = 0
    transformer.tc_skip_count = 0

