    # ── /generate ─────────────────────────────────────────────────────────────
    @modal.method()
    def generate(self, req: dict):
        from PIL import Image
        from scipy.ndimage import binary_dilation
        import os as _os
        import uuid as _uuid

        # [MEM PATCH] reset the peak tracker at the start of every /generate
        # call so "peak" below reflects only this request's memory usage,
        # not whatever accumulated across prior requests on this container.
        self.torch.cuda.reset_peak_memory_stats()
        print(f"[generate] VRAM at start: allocated={self.torch.cuda.memory_allocated()/1e9:.2f}GB "
              f"reserved={self.torch.cuda.memory_reserved()/1e9:.2f}GB")

        t0_total = time.time()

        session_id = req["session_id"]
        prompt     = req["prompt"]
        image_url  = req["image_url"]
        ref_url    = req.get("reference_image_url")
        steps      = req.get("steps", 14)
        guidance   = req.get("guidance", 45.0)
        dilate_px  = req.get("dilate_px", 8)
        seed       = req.get("seed", 0)
        match_ref_bbox = req.get("match_ref_bbox", True)
        diff_cleanup_dilate_px = req.get("diff_cleanup_dilate_px", 3)
        m1_bbox_expand_px = req.get("m1_bbox_expand_px", 20)
        sharpen           = req.get("sharpen", True)
        sharpen_radius    = req.get("sharpen_radius", 2.0)
        sharpen_percent   = req.get("sharpen_percent", 150)
        sharpen_threshold = req.get("sharpen_threshold", 2)

        volume.reload()
        session_dir       = f"/data/{session_id}"
        running_mask_path = f"{session_dir}/running_mask.png"
        running_mask_reference_path = f"{session_dir}/running_mask_reference.png"
        base_path         = f"{session_dir}/base.png"

        if not _os.path.exists(running_mask_path):
            raise FileNotFoundError("Running mask not found — call /segment/choose first.")

        with timed("Load/download target image"):
            if image_url:
                try:
                    init_image = self._download_image(image_url)
                except Exception as e:
                    if _os.path.exists(base_path):
                        print(
                            f"[generate] WARNING: failed to download image_url={image_url!r} "
                            f"({e}); falling back to the cached base image for this session."
                        )
                        init_image = Image.open(base_path).convert("RGB")
                    else:
                        raise
            elif _os.path.exists(base_path):
                init_image = Image.open(base_path).convert("RGB")
            else:
                raise ValueError(
                    "No image_url provided and no cached base image found for this session."
                )

        orig_w, orig_h = init_image.size
        side = max(orig_w, orig_h)

        with timed("Load + align running mask"):
            mask_image_raw  = Image.open(running_mask_path).convert("L")
            if mask_image_raw.size != (orig_w, orig_h):
                print(
                    f"[generate] WARNING: running mask size {mask_image_raw.size} does not "
                    f"match fetched image_url size {(orig_w, orig_h)} — resizing mask to "
                    f"match. If this isn't expected, double-check image_url points to the "
                    f"same photo the mask was drawn on."
                )
                mask_image_raw = mask_image_raw.resize((orig_w, orig_h), Image.NEAREST)

        reference_image = self._download_image(ref_url) if ref_url else None

        if ref_url:
            if not _os.path.exists(running_mask_reference_path):
                raise FileNotFoundError(
                    "Reference running mask not found — call /segment/click and "
                    "/segment/choose with reference_mask=true on the reference image first."
                )
            mask_image_reference = Image.open(running_mask_reference_path).convert("L")
        else:
            mask_image_reference = None

        TILE = int(req.get("tile_size", 768))
        FILL_SIZE = int(req.get("fill_size", 1024))

        generator = self.torch.Generator(device="cuda").manual_seed(seed)
        use_teacache    = req.get("teacache", True)
        teacache_thresh = req.get("teacache_thresh", REL_L1_THRESH)

        debug_urls = {}

        original_forward = None
        if use_teacache:
            with timed("Apply TeaCache patch"):
                original_forward = apply_teacache(
                    self.pipe, num_steps=steps, rel_l1_thresh=teacache_thresh
                )
            print(f"[generate] TeaCache enabled (thresh={teacache_thresh})")

        try:
            if reference_image is not None:
                with timed("Prepare tiles (target/mask/ref pad+resize)"):
                    target_tile = self._pad_and_resize_square(init_image, TILE)
                    mask_tile   = self._pad_and_resize_square(mask_image_raw, TILE)
                    ref_tile    = self._pad_and_resize_square(reference_image, TILE)
                    ref_mask_tile = self._pad_and_resize_square(mask_image_reference, TILE)

                    mask01 = (self.np.array(mask_tile) > 127).astype(self.np.uint8)
                    if mask01.sum() == 0:
                        raise ValueError(
                            "The running mask is empty — no region was selected. "
                            "Call /segment/click and /segment/choose before /generate."
                        )

                    m1 = mask01.copy()

                with timed("Match mask to reference bbox"):
                    m2 = None
                    ref_bbox_wh = None
                    mask_bbox_wh = None
                    if match_ref_bbox:
                        ref_bbox = self._get_object_bbox_scaled(ref_mask_tile, canvas_size=TILE)
                        rx0, ry0, rx1, ry1 = ref_bbox
                        ref_area_frac = ((rx1 - rx0) * (ry1 - ry0)) / float(TILE * TILE)
                        ref_touches_all_edges = (
                            rx0 <= 1 and ry0 <= 1 and rx1 >= TILE - 1 and ry1 >= TILE - 1
                        )
                        bbox_reliable = (ref_area_frac <= 0.75) and (not ref_touches_all_edges)

                        if bbox_reliable:
                            mask01, mask_bbox_wh, ref_bbox_wh = self._match_mask_to_ref_bbox(
                                mask01, ref_bbox, canvas_size=TILE
                            )
                            m2 = mask01.copy()
                        else:
                            print(
                                f"[generate] WARNING: reference bbox looks unreliable "
                                f"(covers {ref_area_frac*100:.0f}% of the tile, "
                                f"touches_all_edges={ref_touches_all_edges}). This usually means "
                                f"the reference image is a full room/lifestyle photo rather than a "
                                f"clean cutout on a white background. Skipping match_ref_bbox for "
                                f"this generation and using the originally selected mask as-is."
                            )
                            m2 = mask01.copy()
                            mask_bbox_wh = None
                            ref_bbox_wh = None

                        print(f"[generate] mask bbox (w,h) BEFORE match: {mask_bbox_wh} px "
                              f"| reference object bbox (w,h) [measured on raw ref, scaled to {TILE}px]: {ref_bbox_wh} px")
                        if mask01.sum() == 0:
                            raise ValueError(
                                "Mask became empty after matching to the reference bbox — "
                                "check that the reference image actually has a clear subject "
                                "on a light background, or set match_ref_bbox=false."
                            )

                with timed("Expand m1 mask directly (no bbox)"):
                    m1_bool = m1.astype(bool)
                    if m1_bbox_expand_px > 0 and m1_bool.any():
                        m1_rect = binary_dilation(m1_bool, iterations=m1_bbox_expand_px)
                    else:
                        m1_rect = m1_bool
                    print(f"[generate] m1 mask px count: {int(m1_bool.sum())} "
                          f"| expanded by {m1_bbox_expand_px}px (dilation) -> "
                          f"{int(m1_rect.sum())} px")

                target_tile = self._lama_fill(
                    target_tile, m1_rect, dilate_px=diff_cleanup_dilate_px
                )

                if dilate_px > 0:
                    mask01 = binary_dilation(mask01, iterations=dilate_px).astype(self.np.uint8)
                mask_tile = Image.fromarray((mask01 * 255).astype(self.np.uint8)).convert("L")

                with timed("Build stitched canvas (no padding)"):
                    canvas_img, canvas_mask_img, (canvas_w, canvas_h) = (
                        self._build_stitched_canvas(target_tile, mask_tile, ref_tile, TILE)
                    )

                debug_urls["debug_canvas_image_url"] = self._upload_to_cloudinary(
                    canvas_img, public_id=f"{session_id}/debug_canvas_image_{_uuid.uuid4().hex}"
                )
                debug_urls["debug_canvas_mask_url"] = self._upload_to_cloudinary(
                    canvas_mask_img, public_id=f"{session_id}/debug_canvas_mask_{_uuid.uuid4().hex}"
                )

                print(f"[generate] fused tiles: {TILE}x{TILE} each -> concatenated canvas "
                      f"{canvas_w}x{canvas_h} (no padding applied)")

                with self.torch.inference_mode():
                    with timed("FLUX.1-Redux prior encode"):
                        redux_out = self.pipe.prior_redux(
                            image=ref_tile, prompt=prompt, prompt_2=prompt
                        )
                prompt_embeds        = redux_out.prompt_embeds.to("cuda", dtype=self.torch.bfloat16)
                pooled_prompt_embeds = redux_out.pooled_prompt_embeds.to("cuda", dtype=self.torch.bfloat16)

                with self.torch.inference_mode():
                    gen_output_canvas = self._call_pipe_safe(
                        prompt_embeds=prompt_embeds,
                        pooled_prompt_embeds=pooled_prompt_embeds,
                        image=canvas_img,
                        mask_image=canvas_mask_img,
                        num_inference_steps=steps,
                        guidance_scale=guidance,
                        height=canvas_img.height,
                        width=canvas_img.width,
                        generator=generator,
                    ).images[0]

                debug_urls["debug_output_canvas_url"] = self._upload_to_cloudinary(
                    gen_output_canvas, public_id=f"{session_id}/debug_output_canvas_{_uuid.uuid4().hex}"
                )

                with timed("Crop target half out of generated canvas"):
                    gen_output = gen_output_canvas.crop((TILE, 0, canvas_w, canvas_h))

            else:
                with timed("Prepare image + mask for plain text-prompt fill"):
                    gen_image    = self._pad_and_resize_square(init_image, FILL_SIZE)
                    gen_mask_img = self._pad_and_resize_square(mask_image_raw, FILL_SIZE)

                    mask01 = (self.np.array(gen_mask_img) > 127).astype(self.np.uint8)
                    if mask01.sum() == 0:
                        raise ValueError(
                            "The running mask is empty — no region was selected. "
                            "Call /segment/click and /segment/choose before /generate."
                        )
                    if dilate_px > 0:
                        mask01 = binary_dilation(mask01, iterations=dilate_px).astype(self.np.uint8)
                    gen_mask = Image.fromarray((mask01 * 255).astype(self.np.uint8)).convert("L")

                debug_urls["debug_canvas_image_url"] = self._upload_to_cloudinary(
                    gen_image, public_id=f"{session_id}/debug_canvas_image_{_uuid.uuid4().hex}"
                )
                debug_urls["debug_canvas_mask_url"] = self._upload_to_cloudinary(
                    gen_mask, public_id=f"{session_id}/debug_canvas_mask_{_uuid.uuid4().hex}"
                )

                with self.torch.inference_mode():
                    gen_output = self._call_pipe_safe(
                        prompt=prompt,
                        prompt_2=prompt,
                        image=gen_image,
                        mask_image=gen_mask,
                        num_inference_steps=steps,
                        guidance_scale=guidance,
                        height=FILL_SIZE,
                        width=FILL_SIZE,
                        generator=generator,
                    ).images[0]

                debug_urls["debug_output_canvas_url"] = self._upload_to_cloudinary(
                    gen_output, public_id=f"{session_id}/debug_output_canvas_{_uuid.uuid4().hex}"
                )

                with timed("Composite generated output onto original"):
                    gen_output = Image.composite(gen_output, gen_image, gen_mask)
        finally:
            if use_teacache and original_forward is not None:
                remove_teacache(self.pipe, original_forward)

        with timed("Progressive upscale to original resolution"):
            square_output = self._progressive_upscale(gen_output, side, side)

        with timed("Remove pad to original aspect ratio"):
            final_output = remove_pad(square_output, orig_w, orig_h)

        if sharpen:
            with timed("Sharpen output"):
                final_output = self._sharpen(
                    final_output,
                    radius=sharpen_radius,
                    percent=sharpen_percent,
                    threshold=sharpen_threshold,
                )

        output_url = self._upload_to_cloudinary(
            final_output, public_id=f"{session_id}/output_{_uuid.uuid4().hex}"
        )
        result = {"output_url": output_url}
        result.update(debug_urls)

        # [MEM PATCH] the number you actually asked about: peak VRAM reached
        # anywhere during this /generate call (SAM2/LaMa/Redux/diffusion all
        # included), plus end-of-request resting allocated/reserved values.
        print(f"[generate] VRAM at end: allocated={self.torch.cuda.memory_allocated()/1e9:.2f}GB "
              f"reserved={self.torch.cuda.memory_reserved()/1e9:.2f}GB "
              f"PEAK during generate={self.torch.cuda.max_memory_allocated()/1e9:.2f}GB")
        print(f"[TIMER] generate TOTAL: {time.time() - t0_total:.3f}s")
        return result


# ---------------------------------------------------------------------------
# Module-level singleton — avoids constructing a new Modal handle per request.
# The GPU container is kept warm by scaledown_window; the handle is cheap to reuse.
# ---------------------------------------------------------------------------
_pipeline = CombinedPipeline()

@app.function(
    image=container_image,
    secrets=ALL_SECRETS,
    # Match the GPU cls timeout so HTTP requests survive a full cold start
    # without hitting the default 300s queue timeout (confirmed bug: 2026-07-20)
    timeout=600,
)
@modal.asgi_app()
def fastapi_app():
    web_app = FastAPI(title="FLUX-Fill & SAM2 Pipeline", version="3.6.0")

    @web_app.post("/segment/click")
    def segment_click_endpoint(payload: ClickRequest):
        session_id = payload.session_id or uuid.uuid4().hex
        try:
            res = _pipeline.segment_click.remote(
                session_id, payload.image_url, payload.cx, payload.cy, payload.max_dim, payload.reference_mask
            )
        except Exception as exc:
            raise HTTPException(status_code=500, detail=str(exc))
        return {
