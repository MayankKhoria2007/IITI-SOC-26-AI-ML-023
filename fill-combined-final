    # ── /segment/extract ──────────────────────────────────────────────────────
    @modal.method()
    def extract_from_session(self, req: dict) -> dict:
        """
        Extracts the object defined by the running session mask:
          1. Load base image + running mask from Volume
          2. Feathered RGBA cutout
          3. LaMa background fill   (skipped when mode='generate')
          4. Depth estimation        (skipped when mode='generate')
          5. Upload outputs to Cloudinary
          6. Return all URLs + placement_meta + mode
        """
        from PIL import Image
        from scipy.ndimage import binary_dilation
        import os as _os

        session_id = req["session_id"]
        mode       = req.get("mode", "move")
        dilate_px  = int(req.get("dilate_px", 10))
        feather_px = int(req.get("feather_px", 3))

        volume.reload()
        session_dir       = f"/data/{session_id}"
        base_path         = f"{session_dir}/base.png"
        running_mask_path = f"{session_dir}/running_mask.png"

        if not _os.path.exists(base_path):
            raise FileNotFoundError("Base image not found — call /segment/click first.")
        if not _os.path.exists(running_mask_path):
            raise FileNotFoundError("Running mask not found — call /segment/choose first.")

        image  = Image.open(base_path).convert("RGB")
        orig_w, orig_h = image.size
        mask01 = (
            self.np.array(Image.open(running_mask_path).convert("L")) > 127
        ).astype(self.np.uint8)

        if mask01.sum() == 0:
            raise ValueError(
                "Running mask is empty — no region selected. "
                "Call /segment/click and /segment/choose first."
            )
        print(f"[extract_from_session:{session_id}] mask={mask01.sum()}px  mode={mode!r}")

        # Feathered RGBA cutout (un-dilated mask → precise object boundary)
        cutout, bbox, centroid = self._extract_cutout(image, mask01, feather_px)

        placement_meta = {
            "bbox":            {"x0": bbox[0], "y0": bbox[1], "x1": bbox[2], "y1": bbox[3]},
            "centroid":        {"x": centroid[0], "y": centroid[1]},
            "cutout_size":     {"width": cutout.width,  "height": cutout.height},
            "background_size": {"width": orig_w,        "height": orig_h},
        }

        result = {
            "session_id":     session_id,
            "mode":           mode,
            "placement_meta": placement_meta,
        }

        if mode == "move":
            # LaMa background fill (dilated mask → no halo)
            lama_mask = mask01.copy()
            if dilate_px > 0:
                lama_mask = binary_dilation(
                    lama_mask, iterations=dilate_px
                ).astype(self.np.uint8)
            lama_mask_pil = Image.fromarray(
                (lama_mask * 255).astype(self.np.uint8)
            ).convert("L")
            clean_bg = self.lama(image, lama_mask_pil)

            # Depth estimation
            depth_8bit, depth_16bit, _ = self._run_depth(image)

            # Upload all four assets concurrently (pure network I/O — no GPU contention)
            from concurrent.futures import ThreadPoolExecutor
            with ThreadPoolExecutor(max_workers=4) as ex:
                f_cutout = ex.submit(self._upload_to_cloudinary, cutout,
                                     f"{session_id}/extract_cutout", "PNG")
                f_bg     = ex.submit(self._upload_to_cloudinary, clean_bg,
                                     f"{session_id}/extract_clean_bg", "PNG")
                f_d8     = ex.submit(self._upload_to_cloudinary, depth_8bit,
                                     f"{session_id}/extract_depth_preview", "PNG")
                f_d16    = ex.submit(self._upload_to_cloudinary, depth_16bit,
                                     f"{session_id}/extract_depth_raw16", "PNG")
            result["cutout_url"]        = f_cutout.result()
            result["clean_bg_url"]      = f_bg.result()
            result["depth_preview_url"] = f_d8.result()
            result["depth_raw16_url"]   = f_d16.result()
        else:
            # generate mode: upload cutout only (no LaMa / no depth)
            result["cutout_url"] = self._upload_to_cloudinary(
                cutout, f"{session_id}/extract_cutout", "PNG"
            )

        print(f"[extract_from_session:{session_id}] Done.")
        return result

    # ── /remove_object ────────────────────────────────────────────────────────
    @modal.method()
    def remove_object(self, session_id: str, inpaint_radius: int = 7, dilate_px: int = 3):
        import os as _os
        import uuid as _uuid
        from PIL import Image

        t0_total = time.time()

        volume.reload()
        session_dir = f"/data/{session_id}"
        base_path = f"{session_dir}/base.png"
        running_mask_path = f"{session_dir}/running_mask.png"

        if not _os.path.exists(base_path):
            raise FileNotFoundError(f"No base image found for session {session_id!r}.")
        if not _os.path.exists(running_mask_path):
            raise FileNotFoundError(
                "Running mask not found — call /segment/click and /segment/choose "
                "to select the object before calling /remove_object."
            )

        with timed("Load base image + running mask"):
            base_img = Image.open(base_path).convert("RGB")
            mask_img = Image.open(running_mask_path).convert("L")
            mask_bool = (self.np.array(mask_img) > 127)

        if mask_bool.sum() == 0:
