    image=container_image,
    volumes={
        "/data":         volume,             # session state (masks, clicks)
        MODEL_CACHE_DIR: model_cache_volume,  # persisted model weights
    },
    secrets=ALL_SECRETS,
    timeout=600,
    scaledown_window=180,
    # ---------------------------------------------------------------------------
    # Memory snapshot: checkpoint the container right after all models are
    # loaded onto the GPU.  On cold start Modal restores from the snapshot,
    # skipping the multi-minute HuggingFace download + CUDA init entirely.
    # GPU snapshot REMOVED: Nunchaku INT4 CUDA kernels cause SIGSEGV on restore
    # (confirmed 2026-07-20 — CPU-only memory snapshot restores cleanly in ~12s)
    # ---------------------------------------------------------------------------
    enable_memory_snapshot=True,
)
class CombinedPipeline:

    # ── Phase 1: snapshotted (runs once, result is checkpointed) ─────────────
    @modal.enter(snap=True)
    def load_models(self):
        """
        Runs once during the first container boot.  The resulting in-memory +
        GPU state is captured as a snapshot.  On every subsequent cold start
        Modal restores from that snapshot, skipping this entire method.
        """
        import os as _os
        _os.environ.setdefault("PYTORCH_CUDA_ALLOC_CONF", "expandable_segments:True")

        # Create model cache subdirectory for simple-lama and symlink it from ~/.cache
        _os.makedirs(f"{MODEL_CACHE_DIR}/simple-lama", exist_ok=True)
        _os.makedirs("/root/.cache", exist_ok=True)
        if not _os.path.exists("/root/.cache/simple-lama"):
            try:
                _os.symlink(f"{MODEL_CACHE_DIR}/simple-lama", "/root/.cache/simple-lama")
                print("[*] Symlinked LaMa cache directory to persistent volume.")
            except Exception as e:
                print(f"[*] Warning: failed to symlink LaMa cache: {e}")

        # Point HF Hub + PyTorch caches to the persistent volume — must be set
        # before any HuggingFace library call so the cache is picked up correctly.
        _os.environ["HF_HOME"]               = MODEL_CACHE_DIR
        _os.environ["HUGGINGFACE_HUB_CACHE"] = MODEL_CACHE_DIR
        _os.environ["TRANSFORMERS_CACHE"]    = MODEL_CACHE_DIR
        _os.environ["HF_DATASETS_CACHE"]     = MODEL_CACHE_DIR
        _os.environ["TORCH_HOME"]            = MODEL_CACHE_DIR
        print(f"[*] Weight cache: {MODEL_CACHE_DIR}")

        import numpy as np
        import torch
        from huggingface_hub import login

        token = _os.environ.get("HF_TOKEN") or _os.environ.get("HUGGINGFACE_TOKEN")
        if token:
            login(token=token)
        else:
            print(
                "[*] WARNING: no HF_TOKEN / HUGGINGFACE_TOKEN found in env — "
                "check that 'huggingface-secret' actually defines one of these keys."
            )

        torch.backends.cuda.matmul.allow_tf32 = True
        torch.backends.cudnn.allow_tf32 = True

        self.np = np
        self.torch = torch

        # [MEM PATCH] reset the peak-memory tracker so the peak reported at the
        # end of this method reflects only what load_models itself allocates.
        torch.cuda.reset_peak_memory_stats()
        total_t0 = time.time()

        # ── A. SAM2 ──────────────────────────────────────────────────────────
        with timed("Load SAM2 (facebook/sam2.1-hiera-large)"):
            print("[*] Loading SAM2 (facebook/sam2.1-hiera-large)...")
            from sam2.sam2_image_predictor import SAM2ImagePredictor
            self.sam_predictor = SAM2ImagePredictor.from_pretrained(
                "facebook/sam2.1-hiera-large",
                device="cuda",
            )
            print(f"    SAM2 loaded. VRAM: {torch.cuda.memory_allocated()/1e9:.2f} GB")

        # ── B. T5-XXL in NF4 (4-bit NormalFloat) ────────────────────────────
        # NF4 reduces T5-XXL from ~9.4 GB → ~2.4 GB of VRAM.
        # compute_dtype=bfloat16 keeps matmul precision high during the forward pass.
        # bitsandbytes handles device placement automatically; no .to("cuda") needed.
        with timed("Load T5-XXL text encoder (NF4)"):
            print("[*] Loading T5-XXL in NF4 (bitsandbytes)...")
            from transformers import T5EncoderModel, BitsAndBytesConfig
            bnb_cfg = BitsAndBytesConfig(
                load_in_4bit=True,
                bnb_4bit_quant_type="nf4",
                bnb_4bit_compute_dtype=torch.bfloat16,
                bnb_4bit_use_double_quant=True,
            )
            text_encoder_2 = T5EncoderModel.from_pretrained(
                "black-forest-labs/FLUX.1-Fill-dev",
                subfolder="text_encoder_2",
                quantization_config=bnb_cfg,
                device_map="cuda",
                token=token,
            )
            print(f"    T5 NF4 loaded. VRAM: {torch.cuda.memory_allocated()/1e9:.2f} GB")

        # ── C. Nunchaku INT4/FP4 FLUX transformer ────────────────────────────
        with timed("Load Nunchaku int4/fp4 transformer"):
            print("[*] Loading Nunchaku int4/fp4 transformer...")
            from nunchaku import NunchakuFluxTransformer2dModel
            from nunchaku.utils import get_precision
            precision = get_precision()
            transformer = NunchakuFluxTransformer2dModel.from_pretrained(
                f"nunchaku-tech/nunchaku-flux.1-fill-dev/"
                f"svdq-{precision}_r32-flux.1-fill-dev.safetensors"
            )
            print(f"    Transformer loaded. VRAM: {torch.cuda.memory_allocated()/1e9:.2f} GB")

        # ── D. FluxFillPipeline ───────────────────────────────────────────────
        with timed("Assemble FluxFillPipeline"):
            print("[*] Assembling FluxFillPipeline...")
            from diffusers import FluxFillPipeline, FluxPriorReduxPipeline
            self.pipe = FluxFillPipeline.from_pretrained(
                "black-forest-labs/FLUX.1-Fill-dev",
                transformer=transformer,
                text_encoder_2=text_encoder_2,
                torch_dtype=torch.bfloat16,
                low_cpu_mem_usage=True,
                token=token,
            ).to("cuda")
            self.pipe.enable_vae_slicing()
            self.pipe.enable_vae_tiling()
            self.pipe.set_progress_bar_config(disable=True)
            print(f"    FluxFill loaded. VRAM: {torch.cuda.memory_allocated()/1e9:.2f} GB")

        import inspect as _inspect
        self._pipe_call_params = set(
            _inspect.signature(self.pipe.__call__).parameters.keys()
        )
        print(f"[*] Pipeline __call__ accepts: {sorted(self._pipe_call_params)}")

        # ── E. FluxPriorRedux (shares CLIP + T5 with pipe) ───────────────────
        with timed("Load FLUX.1-Redux prior"):
            print("[*] Loading FLUX.1-Redux prior...")
            from diffusers import FluxPriorReduxPipeline
            self.pipe.prior_redux = FluxPriorReduxPipeline.from_pretrained(
                "black-forest-labs/FLUX.1-Redux-dev",
                torch_dtype=torch.bfloat16,
                text_encoder=self.pipe.text_encoder,
                text_encoder_2=self.pipe.text_encoder_2,
                tokenizer=self.pipe.tokenizer,
                tokenizer_2=self.pipe.tokenizer_2,
            ).to("cuda")
            # [MEM PATCH] Redux prior had no VRAM checkpoint before — add one.
            print(f"    FLUX.1-Redux prior loaded. VRAM: {torch.cuda.memory_allocated()/1e9:.2f} GB")

        # ── F. LaMa (background inpainting) ──────────────────────────────────
        with timed("Load LaMa"):
            print("[*] Loading LaMa (lightweight inpainting model)...")
            from simple_lama_inpainting import SimpleLama
            self.lama = SimpleLama(device="cuda")
            print(f"    LaMa loaded. VRAM: {torch.cuda.memory_allocated()/1e9:.2f} GB")

        # ── G. Depth-Anything-V2-Small ────────────────────────────────────────
        # Needed by /segment/extract (mode="move") to produce a depth map
        # alongside the object cutout and clean background.
        with timed(f"Load Depth model ({DEPTH_MODEL})"):
            print(f"[*] Loading Depth model ({DEPTH_MODEL})...")
            from transformers import AutoImageProcessor, AutoModelForDepthEstimation
            self.depth_processor = AutoImageProcessor.from_pretrained(DEPTH_MODEL)
            self.depth_model = AutoModelForDepthEstimation.from_pretrained(
                DEPTH_MODEL, torch_dtype=torch.float16
            ).to("cuda").eval()
            print(f"    Depth model ready. VRAM: {torch.cuda.memory_allocated()/1e9:.2f} GB")

        # [MEM PATCH] full picture at the end of load_models: allocated (live
        # tensors), reserved (PyTorch's caching-allocator pool, always >=
        # allocated), and peak (highest allocated value seen during this
        # method — catches any transient spike during weight conversion).
        print(f"[*] All models loaded. Total VRAM allocated: {torch.cuda.memory_allocated()/1e9:.2f} GB")
        print(f"[*] All models loaded. Total VRAM reserved:  {torch.cuda.memory_reserved()/1e9:.2f} GB")
        print(f"[*] All models loaded. Peak VRAM allocated so far: {torch.cuda.max_memory_allocated()/1e9:.2f} GB")
        print(f"[TIMER] load_models TOTAL: {time.time() - total_t0:.3f}s")
        print("[*] Snapshot will be taken after this method returns.")

    # ── Phase 2: post-restore runtime init (runs on every container start) ────
    @modal.enter(snap=False)
    def configure_runtime(self):
        """
        Runs after the snapshot is restored (or immediately after load_models on
        the very first boot).  Keeps live credentials / SDK state out of the
        frozen checkpoint so they are always fresh on every container start.
        """
        import os as _os
        import cloudinary

        # Configure Cloudinary with live secrets — never bake API keys into a snapshot
        cloudinary.config(
            cloud_name=_os.environ.get("CLOUDINARY_CLOUD_NAME"),
            api_key=_os.environ.get("CLOUDINARY_API_KEY"),
            api_secret=_os.environ.get("CLOUDINARY_API_SECRET"),
            secure=True,
        )
        print("[*] Cloudinary configured (post-snapshot runtime init).")

        # [MEM PATCH] snapshot restore can bring back a container whose CUDA
        # context isn't fully re-attached yet; log what we see immediately
        # after restore so restore-time VRAM state is visible in the logs too.
        try:
            import torch as _torch
            print(f"[*] Post-restore VRAM check: allocated={_torch.cuda.memory_allocated()/1e9:.2f}GB "
                  f"reserved={_torch.cuda.memory_reserved()/1e9:.2f}GB")
        except Exception as e:
            print(f"[*] Post-restore VRAM check failed: {e}")

    # ── internal helpers ─────────────────────────────────────────────────────

    def _clean_mask(self, mask01, close_iterations=8):
        from scipy.ndimage import binary_closing, binary_fill_holes
        from scipy.ndimage import label as cc_label

        mask = mask01.astype(bool)
        mask = binary_closing(mask, iterations=close_iterations)
        mask = binary_fill_holes(mask)
        labeled, count = cc_label(mask)
        if count > 1:
            sizes = self.np.bincount(labeled.ravel())
            sizes[0] = 0
            mask = labeled == sizes.argmax()
        return mask.astype(self.np.uint8)

    def _recompute_combined(self, clicks: list, session_dir: str, target_size=None):
        import os as _os
        from PIL import Image as _Image
        active_masks = []
        for c in clicks:
            if c["active"] and c.get("candidate_index") is not None:
                mask_path = (
                    f"{session_dir}/candidate_mask_{c['index']}_{c['candidate_index']}.png"
                )
                if _os.path.exists(mask_path):
                    mask_img = _Image.open(mask_path).convert("L")
                    if target_size is not None and mask_img.size != target_size:
                        print(
                            f"[recompute_combined] WARNING: mask for click {c['index']} "
                            f"has size {mask_img.size} but expected {target_size} — "
                            f"resizing mask to match before combining."
                        )
                        mask_img = mask_img.resize(target_size, _Image.NEAREST)
                    mask_np = (self.np.array(mask_img) > 127).astype(self.np.uint8)
                    active_masks.append(mask_np)
        if not active_masks:
            return None

        # Extra safety net: even with target_size resizing above, guard against
        # any remaining shape mismatch by resizing every subsequent mask to the
        # shape of the first one.
        combined = active_masks[0].copy()
        ref_shape = combined.shape
        for m in active_masks[1:]:
            if m.shape != ref_shape:
                print(
                    f"[recompute_combined] WARNING: mask shape {m.shape} does not match "
                    f"reference shape {ref_shape} — resizing to match before combining."
                )
                m_img = _Image.fromarray((m * 255).astype(self.np.uint8))
                m_img = m_img.resize((ref_shape[1], ref_shape[0]), _Image.NEAREST)
                m = (self.np.array(m_img) > 127).astype(self.np.uint8)
            combined = self.np.logical_or(combined, m).astype(self.np.uint8)
        return combined

    def _apply_removals(self, clicks: list, remove_indices: List[int]) -> List[int]:
        applied = []
        valid_indices = {c["index"] for c in clicks}
        for idx in remove_indices:
            if idx not in valid_indices:
                print(f" [WARNING] cannot remove click {idx}: no such click in session.")
                continue
            matched = next(c for c in clicks if c["index"] == idx)
            if not matched["active"]:
                print(f" [WARNING] click {idx} is already inactive/removed.")
                continue
            matched["active"] = False
            applied.append(idx)
            print(
                f" [INFO] removed click {idx} "
                f"(cx={matched['cx']}, cy={matched['cy']}) from the union."
            )
        return applied

    def _active_click_indices(self, clicks: list) -> List[int]:
        return [c["index"] for c in clicks if c["active"]]

    def _extract_cutout(self, image_rgb, mask01, feather_px: int = 3):
        """
        Build a feathered RGBA cutout of the masked object.
        Returns:
            cutout   – PIL RGBA (cropped to bbox + feather margin)
            bbox     – (x0, y0, x1, y1) in original-image pixel space
            centroid – (cx, cy)
        """
        from PIL import Image as _Image
        from scipy.ndimage import distance_transform_edt

        mask  = mask01.astype(bool)
        dist  = distance_transform_edt(mask)
        alpha = self.np.zeros(mask.shape, dtype=self.np.float32)
        alpha[mask] = self.np.clip(dist[mask] / max(feather_px, 1), 0.0, 1.0)

        rgba        = self.np.dstack(
            [self.np.array(image_rgb), (alpha * 255).astype(self.np.uint8)]
        )
        cutout_full = _Image.fromarray(rgba, mode="RGBA")

        ys, xs = self.np.where(mask)
        y0 = max(int(ys.min()) - feather_px, 0)
        y1 = min(int(ys.max()) + feather_px, mask.shape[0])
        x0 = max(int(xs.min()) - feather_px, 0)
        x1 = min(int(xs.max()) + feather_px, mask.shape[1])

        cutout   = cutout_full.crop((x0, y0, x1, y1))
        centroid = (int(xs.mean()), int(ys.mean()))
        return cutout, (x0, y0, x1, y1), centroid

    def _run_depth(self, image_rgb):
        """
        Run Depth-Anything-V2-Small on a PIL RGB image.
        Returns:
            depth_pil_8bit  – PIL "L" image (0-255 grayscale)
            depth_pil_16bit – PIL "I;16" image (0-65535)
            depth_np        – raw float32 normalised depth array
        """
        from PIL import Image as _Image

        self.torch.cuda.synchronize()
        t0 = time.perf_counter()

        inputs = self.depth_processor(
            images=image_rgb, return_tensors="pt"
        ).to("cuda")
        inputs = {
            k: v.to(self.torch.float16) if v.dtype == self.torch.float32 else v
            for k, v in inputs.items()
        }

        with self.torch.inference_mode():
            outputs         = self.depth_model(**inputs)
            predicted_depth = outputs.predicted_depth

        prediction = self.torch.nn.functional.interpolate(
            predicted_depth.unsqueeze(1).float(),
            size=(image_rgb.height, image_rgb.width),
            mode="bicubic",
            align_corners=False,
        ).squeeze()

        self.torch.cuda.synchronize()
        latency = time.perf_counter() - t0

        depth_np     = prediction.cpu().numpy().astype(self.np.float32)
        d_min, d_max = depth_np.min(), depth_np.max()
        depth_norm   = (depth_np - d_min) / max(d_max - d_min, 1e-6)

        depth_8bit  = (depth_norm * 255.0).astype(self.np.uint8)
        depth_16bit = (depth_norm * 65535.0).astype(self.np.uint16)

        peak_vram = self.torch.cuda.max_memory_allocated() / (1024 ** 3)
        print(f"[depth] latency={latency*1000:.1f}ms  peak_vram={peak_vram:.2f}GB  "
              f"input={image_rgb.size}")

        return (
            _Image.fromarray(depth_8bit,  mode="L"),
            _Image.fromarray(depth_16bit, mode="I;16"),
            depth_np,
        )

    def _upload_to_cloudinary(self, pil_image, public_id: str, fmt: str = "PNG") -> str:
        """Upload a PIL image to Cloudinary; return its secure URL.
        `fmt` defaults to PNG; pass 'PNG' explicitly for 16-bit/RGBA images."""
        import cloudinary.uploader
        import io as _io
        with timed(f"Upload to Cloudinary ({public_id})"):
            buf = _io.BytesIO()
            pil_image.save(buf, format=fmt)
            buf.seek(0)
            result = cloudinary.uploader.upload(
                buf,
                public_id=public_id,
                folder="flux-sam2",
                overwrite=True,
                resource_type="image",
            )
        return result["secure_url"]

    def _download_image(self, url: str):
        import urllib.request as _urlreq
        import io as _io
        from PIL import Image
        with timed(f"Download image ({url})"):
            try:
                req = _urlreq.Request(
                    url,
                    headers={"User-Agent": "flux-sam2-pipeline/2.0 (contact: admin@example.com)"},
                )
                with _urlreq.urlopen(req) as resp:
                    data = resp.read()
                return Image.open(_io.BytesIO(data)).convert("RGB")
            except Exception as e:
                raise ValueError(f"Failed to download {url!r}: {e}") from None

    def _call_pipe_safe(self, **kwargs):
        accepted = getattr(self, "_pipe_call_params", None)
        if accepted is None:
            import inspect as _inspect
            accepted = set(_inspect.signature(self.pipe.__call__).parameters.keys())
            self._pipe_call_params = accepted

        clean_kwargs = {}
        for k, v in kwargs.items():
            if k in accepted:
                clean_kwargs[k] = v
            else:
                print(
                    f"[generate] pipeline does not accept '{k}' in this diffusers "
                    f"version — dropping it (no effect from this argument)."
                )
        with timed("FluxFill pipe() forward/diffusion call"):
            result = self.pipe(**clean_kwargs)
        # [MEM PATCH] this is the number you actually want: VRAM immediately
        # after the diffusion forward pass (the biggest memory consumer in
        # the whole request — attention maps + latents for the full canvas).
        print(f"[diffusion] VRAM after pipe() call: allocated={self.torch.cuda.memory_allocated()/1e9:.2f}GB "
              f"reserved={self.torch.cuda.memory_reserved()/1e9:.2f}GB "
              f"peak-so-far={self.torch.cuda.max_memory_allocated()/1e9:.2f}GB")
        return result

    def _progressive_upscale(self, img, target_w, target_h):
        cur_w, cur_h = img.size
        if target_w <= cur_w and target_h <= cur_h:
            return img.resize((target_w, target_h), Image.LANCZOS)
        while cur_w * 2 < target_w and cur_h * 2 < target_h:
            cur_w, cur_h = cur_w * 2, cur_h * 2
            img = img.resize((cur_w, cur_h), Image.LANCZOS)
        return img.resize((target_w, target_h), Image.LANCZOS)

    def _sharpen(self, img, radius=2.0, percent=150, threshold=2):
        from PIL import ImageFilter
        return img.filter(
            ImageFilter.UnsharpMask(radius=radius, percent=percent, threshold=threshold)
        )

    def _pad_and_resize_square(self, img, size):
        if img.mode == "L":
            padded = pad_mask_to_square(img)
            resample = Image.NEAREST
        else:
            padded = pad_to_square(img)
            resample = Image.LANCZOS
        return padded.resize((size, size), resample)

    def _get_object_bbox(self, img_rgb, bg_thresh=10):
        arr = self.np.array(img_rgb.convert("RGB"))
        h, w = arr.shape[:2]
        non_bg = self.np.any(arr > bg_thresh, axis=-1)
        ys, xs = self.np.where(non_bg)
        if len(xs) == 0 or len(ys) == 0:
            return (0, 0, w, h)
        x0, x1 = int(xs.min()), int(xs.max()) + 1
        y0, y1 = int(ys.min()), int(ys.max()) + 1
        x1 = max(x1, x0 + 1)
        y1 = max(y1, y0 + 1)
        return (x0, y0, x1, y1)

    def _get_object_bbox_scaled(self, ref_original, canvas_size, bg_thresh=10):
        rw, rh = ref_original.size
        side = max(rw, rh)
        pad_x = (side - rw) // 2
        pad_y = (side - rh) // 2
        scale = canvas_size / side

        x0, y0, x1, y1 = self._get_object_bbox(ref_original, bg_thresh=bg_thresh)

        sx0 = (x0 + pad_x) * scale
        sy0 = (y0 + pad_y) * scale
        sx1 = (x1 + pad_x) * scale
        sy1 = (y1 + pad_y) * scale

        sx1 = max(sx1, sx0 + 1)
        sy1 = max(sy1, sy0 + 1)
        return (int(round(sx0)), int(round(sy0)), int(round(sx1)), int(round(sy1)))

    def _match_mask_to_ref_bbox(self, mask01, ref_bbox, canvas_size):
        ys, xs = self.np.where(mask01 > 0)
        if len(xs) == 0 or len(ys) == 0:
            return mask01, (0, 0), (0, 0)

        mx0, mx1 = int(xs.min()), int(xs.max()) + 1
        my0, my1 = int(ys.min()), int(ys.max()) + 1
        mask_w, mask_h = mx1 - mx0, my1 - my0

        rx0, ry0, rx1, ry1 = ref_bbox
        ref_w = max(rx1 - rx0, 1)
        ref_h = max(ry1 - ry0, 1)
        ref_w = min(ref_w, canvas_size)
        ref_h = min(ref_h, canvas_size)

        scale_w = mask_w / float(ref_w) if ref_w > 0 else 1.0
        scale_h = mask_h / float(ref_h) if ref_h > 0 else 1.0
        scale_factor = min(scale_w, scale_h)

        target_w = max(int(round(ref_w * scale_factor)), 1)
        target_h = max(int(round(ref_h * scale_factor)), 1)

        if target_w > canvas_size or target_h > canvas_size:
            clamp_scale = min(canvas_size / target_w, canvas_size / target_h)
            target_w = max(int(round(target_w * clamp_scale)), 1)
            target_h = max(int(round(target_h * clamp_scale)), 1)

        print(f"[match_mask_to_ref_bbox] mask(w,h)=({mask_w},{mask_h}) "
              f"ref(w,h)=({ref_w},{ref_h}) scale_w={scale_w:.3f} scale_h={scale_h:.3f} "
              f"contain_scale={scale_factor:.3f} -> target(w,h)=({target_w},{target_h})")

        sub = Image.fromarray((mask01[my0:my1, mx0:mx1] * 255).astype(self.np.uint8))
        try:
            resized_sub = sub.resize((target_w, target_h), Image.NEAREST)
        except Exception:
            return mask01, (mask_w, mask_h), (ref_w, ref_h)

        mask_cx = (mx0 + mx1) // 2
        new_left = mask_cx - target_w // 2
        new_top = my1 - target_h

        canvas = Image.new("L", (canvas_size, canvas_size), 0)
        canvas.paste(resized_sub, (new_left, new_top))
        new_mask01 = (self.np.array(canvas) > 127).astype(self.np.uint8)
        return new_mask01, (mask_w, mask_h), (ref_w, ref_h)

    def _mask_bbox_dims(self, mask_bool):
        ys, xs = self.np.where(mask_bool)
        if len(xs) == 0 or len(ys) == 0:
            return None, (0, 0)
        x0, x1 = int(xs.min()), int(xs.max()) + 1
        y0, y1 = int(ys.min()), int(ys.max()) + 1
        return (x0, y0, x1, y1), (x1 - x0, y1 - y0)

    def _get_generated_object_mask(self, arr, region_mask_bool, bg_color,
                                   color_thresh=30.0, smooth_sigma=1.0, close_iterations=3):
        from scipy.ndimage import gaussian_filter, binary_closing, binary_opening

        region_mask_bool = region_mask_bool.astype(bool)
        color_dist = self.np.linalg.norm(
            arr.astype(self.np.float32) - bg_color.reshape(1, 1, 3), axis=-1
        )
        color_dist = gaussian_filter(color_dist, sigma=smooth_sigma)

        object_mask = region_mask_bool & (color_dist > color_thresh)
        object_mask = binary_opening(object_mask, iterations=1)
        object_mask = binary_closing(object_mask, iterations=close_iterations)
        return object_mask

    def _lama_fill(self, pil_image_rgb, mask_bool, dilate_px: int = 0, telea_radius: int = 7):
        if mask_bool.sum() == 0:
            return pil_image_rgb

        from scipy.ndimage import binary_dilation
        work_mask = mask_bool
        if dilate_px > 0:
            work_mask = binary_dilation(mask_bool, iterations=dilate_px)

        try:
            with timed("LaMa fill"):
                mask_img = Image.fromarray(
                    (work_mask.astype(self.np.uint8) * 255)
                ).convert("L")
                result = self.lama(pil_image_rgb.convert("RGB"), mask_img)
                if not isinstance(result, Image.Image):
                    result = Image.fromarray(self.np.array(result).astype(self.np.uint8))
                result = result.convert("RGB")
            # [MEM PATCH] VRAM right after LaMa's forward pass.
            print(f"[lama] VRAM after fill: allocated={self.torch.cuda.memory_allocated()/1e9:.2f}GB "
                  f"reserved={self.torch.cuda.memory_reserved()/1e9:.2f}GB "
                  f"peak-so-far={self.torch.cuda.max_memory_allocated()/1e9:.2f}GB")
            return result
        except Exception as e:
            print(f"[generate] LaMa fill failed ({e}); falling back to OpenCV Telea inpainting.")
            with timed("OpenCV Telea fallback inpainting"):
                import cv2
                arr = self.np.array(pil_image_rgb.convert("RGB"), dtype=self.np.uint8)
                mask_u8 = (work_mask.astype(self.np.uint8)) * 255
                inpainted = cv2.inpaint(arr, mask_u8, inpaintRadius=telea_radius, flags=cv2.INPAINT_TELEA)
                return Image.fromarray(inpainted)

    def _sample_point_outside_mask(self, arr, exclude_mask_bool, anchor_mask_bool=None,
                                   margin=10, patch_radius=3):
        h, w = exclude_mask_bool.shape

        anchor = anchor_mask_bool if (anchor_mask_bool is not None and anchor_mask_bool.sum() > 0) else exclude_mask_bool
        ys, xs = self.np.where(anchor)
        if len(xs) == 0:
            cx, top_y = w // 2, h // 2
        else:
            cx = int(round((int(xs.min()) + int(xs.max())) / 2))
            top_y = int(ys.min())

        cx = min(max(cx, 0), w - 1)
        y = min(max(top_y, 0), h - 1)
        while y > 0 and exclude_mask_bool[y, cx]:
            y -= 1
        y = max(0, y - margin)

        y0, y1 = max(0, y - patch_radius), min(h, y + patch_radius + 1)
        x0, x1 = max(0, cx - patch_radius), min(w, cx + patch_radius + 1)
        patch = arr[y0:y1, x0:x1]
        return patch.reshape(-1, arr.shape[-1]).mean(axis=0)

    def _build_stitched_canvas(self, target_tile, mask_tile, ref_tile, half):
        canvas_w, canvas_h = half * 2, half

        canvas = Image.new("RGB", (canvas_w, canvas_h), (255, 255, 255))
        canvas.paste(ref_tile, (0, 0))
        canvas.paste(target_tile, (half, 0))

        canvas_mask = Image.new("L", (canvas_w, canvas_h), 0)
        canvas_mask.paste(mask_tile, (half, 0))

        return canvas, canvas_mask, (canvas_w, canvas_h)

    # ── /segment/click ────────────────────────────────────────────────────────
    @modal.method()
    def segment_click(self, session_id: str, image_url: Optional[str],
                        cx: float, cy: float, max_dim: int, reference_mask: bool):
        from PIL import Image, ImageDraw
        import os as _os
        import json as _json

        t0_total = time.time()

        volume.reload()
        session_dir = f"/data/{session_id}"
        _os.makedirs(session_dir, exist_ok=True)

        if reference_mask:
            clicks_json_path = f"{session_dir}/reference_clicks.json"
            base_path = f"{session_dir}/base_reference.png"
        else:
            clicks_json_path = f"{session_dir}/clicks.json"
            base_path = f"{session_dir}/base.png"

        if not _os.path.exists(base_path):
            if not image_url:
                raise ValueError(
                    "No base image for this session — provide image_url on the first click."
                )
            original_image = self._download_image(image_url)
            original_image.save(base_path)
            volume.commit()
            volume.reload()
        else:
            with timed("Load cached base image from volume"):
                original_image = Image.open(base_path).convert("RGB")

        clicks = []
        if _os.path.exists(clicks_json_path):
            with open(clicks_json_path, "r") as f:
                clicks = _json.load(f)

        if clicks and clicks[-1].get("candidate_index") is None:
            click_index = clicks[-1]["index"]
            clicks[-1] = {
                "index": click_index,
                "cx": cx,
                "cy": cy,
                "active": False,
                "candidate_index": None
            }
        else:
            click_index = len(clicks)
            clicks.append({
                "index": click_index,
                "cx": cx,
                "cy": cy,
                "active": False,
                "candidate_index": None
            })

        with open(clicks_json_path, "w") as f:
            _json.dump(clicks, f)

        orig_w, orig_h = original_image.size

        with timed("Pad + resize image for SAM2"):
            side = max(orig_w, orig_h)
            pad_x = (side - orig_w) // 2
            pad_y = (side - orig_h) // 2
            padded_image = pad_to_square(original_image)

            scale = max_dim / side
            new_dim = max(16, (int(round(side * scale)) // 16) * 16)
            resized_image = padded_image.resize((new_dim, new_dim), Image.LANCZOS)

        px = min(max(int(round((cx + pad_x) * new_dim / side)), 0), new_dim - 1)
        py = min(max(int(round((cy + pad_y) * new_dim / side)), 0), new_dim - 1)

        with timed("SAM2 set_image + predict"):
            self.sam_predictor.set_image(self.np.array(resized_image))
            coords = self.np.array([[px, py]], dtype=self.np.float32)
            labels = self.np.array([1], dtype=self.np.int32)
            masks, scores, _ = self.sam_predictor.predict(
                point_coords=coords,
                point_labels=labels,
                multimask_output=True,
            )
        # [MEM PATCH] VRAM right after SAM2's predict call.
        print(f"[segment_click] VRAM after SAM2 predict: allocated={self.torch.cuda.memory_allocated()/1e9:.2f}GB "
              f"reserved={self.torch.cuda.memory_reserved()/1e9:.2f}GB "
              f"peak={self.torch.cuda.max_memory_allocated()/1e9:.2f}GB")

        candidates = []
        with timed("Build + upload candidate overlays (all candidates)"):
            for idx, mask_candidate in enumerate(masks):
                cleaned = self._clean_mask(mask_candidate)

                mask_small      = Image.fromarray((cleaned * 255).astype(self.np.uint8)).convert("L")
                mask_padded_full  = mask_small.resize((side, side), Image.NEAREST)
                mask_full         = remove_pad(mask_padded_full, orig_w, orig_h)
                mask_full.save(f"{session_dir}/candidate_mask_{click_index}_{idx}.png")

                img_np   = self.np.array(original_image, dtype=self.np.float32)
                mask_np  = (self.np.array(mask_full) > 127)
                highlight = self.np.array([0, 220, 80], dtype=self.np.float32)

                blended       = img_np.copy()
                blended[mask_np] = img_np[mask_np] * 0.45 + highlight * 0.55
                overlay = Image.fromarray(blended.clip(0, 255).astype(self.np.uint8))

                draw = ImageDraw.Draw(overlay)
                r_outer, r_inner = 14, 10

                for c in clicks:
                    if c["active"] and c["index"] != click_index:
                        pcx, pcy = c["cx"], c["cy"]
                        draw.ellipse([pcx - r_outer, pcy - r_outer, pcx + r_outer, pcy + r_outer],
                                       fill=(255, 255, 255), outline=(255, 255, 255))
                        draw.ellipse([pcx - r_inner, pcy - r_inner, pcx + r_inner, pcy + r_inner],
                                       fill=(220, 30, 30), outline=(220, 30, 30))

                draw.ellipse([cx - r_outer, cy - r_outer, cx + r_outer, cy + r_outer],
                           fill=(255, 255, 255), outline=(255, 255, 255))
                draw.ellipse([cx - r_inner, cy - r_inner, cx + r_inner, cy + r_inner],
                           fill=(220, 30, 30), outline=(220, 30, 30))

                overlay_url = self._upload_to_cloudinary(
                    overlay, public_id=f"{session_id}/candidate_overlay_{click_index}_{idx}"
                )
                candidates.append({
                    "candidate_index": idx,
                    "score": float(scores[idx]),
                    "overlay_url": overlay_url,
                })

        volume.commit()
        print(f"[TIMER] segment_click TOTAL: {time.time() - t0_total:.3f}s")
        return {"click_index": click_index, "candidates": candidates}

    # ── /segment/choose ───────────────────────────────────────────────────────
    @modal.method()
    def segment_choose(self, session_id: str, candidate_index: int, reference_mask: bool, click_index: Optional[int] = None):
        from PIL import Image
        import os as _os
        import json as _json

        t0_total = time.time()

        volume.reload()
        session_dir = f"/data/{session_id}"
        if reference_mask:
            running_mask_path = f"{session_dir}/running_mask_reference.png"
            clicks_json_path = f"{session_dir}/reference_clicks.json"
            base_path = f"{session_dir}/base_reference.png"
        else:
            running_mask_path = f"{session_dir}/running_mask.png"
            clicks_json_path = f"{session_dir}/clicks.json"
            base_path = f"{session_dir}/base.png"

        if not _os.path.exists(clicks_json_path):
            raise FileNotFoundError(f"No clicks found in session {session_id!r}.")

        with open(clicks_json_path, "r") as f:
            clicks = _json.load(f)

        if click_index is None:
            pending_clicks = [c for c in clicks if c.get("candidate_index") is None]
            if pending_clicks:
                click_index = pending_clicks[-1]["index"]
            elif clicks:
                click_index = clicks[-1]["index"]
            else:
                raise ValueError("No clicks found in click history.")

        for c in clicks:
            if c["index"] == click_index:
                c["candidate_index"] = candidate_index
                c["active"] = True
                break
        else:
            raise FileNotFoundError(f"Click index {click_index} not found in click history.")

        with open(clicks_json_path, "w") as f:
            _json.dump(clicks, f)

        chosen_mask_path = f"{session_dir}/candidate_mask_{click_index}_{candidate_index}.png"
        if not _os.path.exists(chosen_mask_path):
            raise FileNotFoundError(
                f"Candidate mask {candidate_index} for click {click_index} not found. "
                f"Call /segment/click first."
            )

        with timed("Recompute combined mask"):
            base_img = Image.open(base_path).convert("RGB")
            combined = self._recompute_combined(
                clicks, session_dir, target_size=(base_img.width, base_img.height)
            )
            if combined is None:
                combined = self.np.zeros((base_img.height, base_img.width), dtype=self.np.uint8)
            print(f" [choose] active clicks: {self._active_click_indices(clicks)} "
                  f"| union covers {int(combined.sum())} px")

            Image.fromarray((combined * 255).astype(self.np.uint8)).convert("L").save(
                running_mask_path
            )

        with timed("Build running overlay"):
            img_np   = self.np.array(base_img, dtype=self.np.float32)
            mask_np  = combined.astype(bool)
            highlight = self.np.array([0, 220, 80], dtype=self.np.float32)
            blended  = img_np.copy()
            blended[mask_np] = img_np[mask_np] * 0.45 + highlight * 0.55
            running_overlay = Image.fromarray(blended.clip(0, 255).astype(self.np.uint8))

            from PIL import ImageDraw
            draw = ImageDraw.Draw(running_overlay)
            r_outer, r_inner = 14, 10
            for c in clicks:
                if c["active"]:
                    cx, cy = c["cx"], c["cy"]
                    draw.ellipse([cx - r_outer, cy - r_outer, cx + r_outer, cy + r_outer],
                               fill=(255, 255, 255), outline=(255, 255, 255))
                    draw.ellipse([cx - r_inner, cy - r_inner, cx + r_inner, cy + r_inner],
                               fill=(220, 30, 30), outline=(220, 30, 30))

        running_overlay_url = self._upload_to_cloudinary(
            running_overlay, public_id=f"{session_id}/running_overlay"
        )

        volume.commit()
        print(f"[TIMER] segment_choose TOTAL: {time.time() - t0_total:.3f}s")
        return {
            "status": "ok",
            "running_overlay_url": running_overlay_url,
            "active_indices": [c["index"] for c in clicks if c["active"]]
        }

