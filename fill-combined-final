class ExtractFromSessionRequest(BaseModel):
    """
    POST /segment/extract
    Uses the running mask already built in a session (via /segment/click + /segment/choose)
    to extract the object cutout, fill the background with LaMa, and run depth estimation.
    Returns all Cloudinary URLs plus a `mode` hint the client uses for UI routing:
      - mode="move"     → user wants to drag-and-drop the cutout onto another scene
      - mode="generate" → user wants to FLUX-inpaint the masked region instead
